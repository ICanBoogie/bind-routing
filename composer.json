{
  "name": "icanboogie/bind-routing",
  "type": "library",
  "description": "Binds icanboogie/routing to ICanBoogie.",
  "keywords": [
    "routing",
    "icanboogie"
  ],
  "homepage": "https://icanboogie.org/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/ICanBoogie/bind-routing/issues",
    "source": "https://github.com/ICanBoogie/bind-routing"
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true,
    "allow-plugins": {
      "icanboogie/autoconfig": true,
      "olvlvl/composer-attribute-collector": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "icanboogie/icanboogie": "^7.0",
    "icanboogie/routing": "^7.0"
  },
  "require-dev": {
    "composer/pcre": "^3.2",
    "icanboogie/console": "^7.0",
    "olvlvl/composer-attribute-collector": "^3.0",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "ICanBoogie\\Binding\\Routing\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\ICanBoogie\\Binding\\Routing\\": "tests/lib"
    },
    "files": [
      "vendor/attributes.php"
    ]
  },
  "extra": {
    "icanboogie": {
      "config-path": "config",
      "config-constructor": {
        "ICanBoogie\\Routing\\Config": "ICanBoogie\\Routing\\ConfigBuilder"
      }
    },
    "composer-attribute-collector": {
      "include": [
        "tests/lib"
      ]
    }
  }
}
